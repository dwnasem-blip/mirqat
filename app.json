{
  "expo": {
    "name": "مِرقاة - MIRQAT",
    "slug": "mirqat",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mirqat",
    "userInterfaceStyle": "automatic",
    "description": "Islamic Learning Platform - ارتقِ بعلمك، وازدد قرباً",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.mirqat.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to calculate prayer times and find Qibla direction.",
        "NSCameraUsageDescription": "Camera access is optional for profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B5E46",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "package": "com.mirqat.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "*.mirqat.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B5E46",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
